<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.hytalemodding.blovien</groupId>
    <artifactId>relwind-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Relwind</name>
    <description>Entity relationships for Hytale's Java ECS.</description>
    <licenses>
        <license>
            <name>GNU Lesser General Public License, version 3.0 only</name>
            <url>https://www.gnu.org/licenses/lgpl-3.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>relwind-component</module>
        <module>relwind-coreserver</module>
        <module>relwind</module>
        <module>relwind-examples</module>
    </modules>

    <properties>
        <hytale.channel>pre-release</hytale.channel>
        <hytale.version>0.7.0-pre.3.1</hytale.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.build.outputTimestamp>2026-09-10T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <!-- Published pre-release is the default. Select release with -Dhytale.channel=release. -->
    <profiles>
        <profile>
            <id>hytale-release</id>
            <activation><property><name>hytale.channel</name><value>release</value></property></activation>
            <properties>
                <hytale.channel>release</hytale.channel>
                <hytale.version>0.6.8</hytale.version>
            </properties>
            <repositories>
                <repository>
                    <id>hytale-release</id>
                    <url>https://maven.hytale.com/release</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </repository>
            </repositories>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>require-hytale-release</id>
                                <goals><goal>enforce</goal></goals>
                                <configuration>
                                    <rules>
                                        <requireProperty>
                                            <property>hytale.channel</property>
                                            <regex>release</regex>
                                            <message>Select exactly one Hytale channel: release or pre-release.</message>
                                        </requireProperty>
                                        <requireProperty>
                                            <property>hytale.version</property>
                                            <regex>0[.]6[.]8</regex>
                                            <message>The release channel requires pinned version 0.6.8.</message>
                                        </requireProperty>
                                        <bannedDependencies>
                                            <excludes><exclude>com.hypixel.hytale:*</exclude></excludes>
                                            <includes><include>com.hypixel.hytale:Server</include></includes>
                                        </bannedDependencies>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>hytale-pre-release</id>
            <activation>
                <activeByDefault>true</activeByDefault>
                <property><name>hytale.channel</name><value>pre-release</value></property>
            </activation>
            <properties>
                <hytale.channel>pre-release</hytale.channel>
                <hytale.version>0.7.0-pre.3.1</hytale.version>
            </properties>
            <repositories>
                <repository>
                    <id>hytale-pre-release</id>
                    <url>https://maven.hytale.com/pre-release</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </repository>
            </repositories>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>require-hytale-pre-release</id>
                                <goals><goal>enforce</goal></goals>
                                <configuration>
                                    <rules>
                                        <requireProperty>
                                            <property>hytale.channel</property>
                                            <regex>pre-release</regex>
                                            <message>Select exactly one Hytale channel: release or pre-release.</message>
                                        </requireProperty>
                                        <requireProperty>
                                            <property>hytale.version</property>
                                            <regex>0[.]7[.]0-pre[.]3[.]1</regex>
                                            <message>The pre-release channel requires pinned version 0.7.0-pre.3.1.</message>
                                        </requireProperty>
                                        <bannedDependencies>
                                            <excludes><exclude>com.hypixel.hytale:*</exclude></excludes>
                                            <includes><include>com.hypixel.hytale:Server</include></includes>
                                        </bannedDependencies>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <resources>
            <resource><directory>src/main/resources</directory></resource>
            <resource>
                <directory>${project.basedir}/..</directory>
                <includes><include>LICENSE</include></includes>
                <targetPath>META-INF</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>hytale-channel-sources</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration>
                            <sources><source>src/main/${hytale.channel}/java</source></sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>hytale-channel-tests</id>
                        <phase>generate-test-sources</phase>
                        <goals><goal>add-test-source</goal></goals>
                        <configuration>
                            <sources><source>src/test/${hytale.channel}/java</source></sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <id>javadoc-license</id>
                        <phase>prepare-package</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/javadoc-resources/resources</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/..</directory>
                                    <includes><include>LICENSE</include></includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                        </manifest>
                        <manifestEntries><License>LGPL-3.0-only</License></manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Implementation-Version>${project.version}</Implementation-Version>
                            <License>LGPL-3.0-only</License>
                        </manifestEntries>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>sources</id>
                        <goals><goal>jar-no-fork</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <configuration>
                    <doclint>all,-missing</doclint>
                    <detectJavaApiLink>false</detectJavaApiLink>
                    <notimestamp>true</notimestamp>
                    <bottom>Copyright 2026 Relwind contributors. LGPL-3.0-only.</bottom>
                    <javadocDirectory>${project.build.directory}/javadoc-resources</javadocDirectory>
                    <docfilessubdirs>true</docfilessubdirs>
                    <archive>
                        <manifestEntries>
                            <Implementation-Version>${project.version}</Implementation-Version>
                            <License>LGPL-3.0-only</License>
                        </manifestEntries>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>javadoc</id>
                        <goals><goal>jar</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.6.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
